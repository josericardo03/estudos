# Preencha depois de criar o projeto e rodar supabase/schema.sql.
# Enquanto estiverem vazias, o app guarda tudo no IndexedDB deste navegador.
# Na Vercel, use os mesmos nomes. Não coloque a senha do banco nem a service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Se o projeto ainda mostrar a chave anon antiga, ela também serve no lugar da publishable:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
